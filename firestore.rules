rules_version = '2';
// RT Registry Prep: the two member accounts share one data space, spaces/main.
// spaces/main.members is a list of auth uids. It can only be changed with admin
// access (Firebase console or gcloud), never from the app. Everyone else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/spaces/main).data.members;
    }

    match /spaces/main {
      allow read: if isMember();

      // One doc per answered, incorrect or skipped question (study and exams). Append-only.
      match /attempts/{id} {
        allow read, delete: if isMember();
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['qid', 'answered_at', 'result', 'choice', 'source', 'created_at'])
          && request.resource.data.qid is string
          && request.resource.data.answered_at is timestamp
          && request.resource.data.result in [0, 1, 2]
          && request.resource.data.choice is int
          && request.resource.data.choice >= -1 && request.resource.data.choice <= 3
          && request.resource.data.source in ['s', 'x']
          && request.resource.data.created_at == request.time;
      }
      // One doc per finished practice exam; "data" is the full answer sheet as JSON.
      match /exams/{id} {
        allow read, write: if isMember();
      }
      // Small key/value state, currently the shared exam in progress ("active_exam").
      match /app_state/{key} {
        allow read, write: if isMember();
      }
    }
  }
}
