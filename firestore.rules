rules_version = '2';
// RT Registry Prep: every document lives under users/{uid}, and a signed-in
// account can only read and write its own subtree.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }

    match /users/{uid} {
      // One doc per answered, incorrect or skipped question (study and exams). Append-only.
      match /attempts/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['qid', 'answered_at', 'result', 'choice', 'source', 'created_at'])
          && request.resource.data.qid is string
          && request.resource.data.answered_at is timestamp
          && request.resource.data.result in [0, 1, 2]
          && request.resource.data.choice is int
          && request.resource.data.choice >= -1 && request.resource.data.choice <= 3
          && request.resource.data.source in ['s', 'x']
          && request.resource.data.created_at == request.time;
      }
      // One doc per finished practice exam; "data" is the full answer sheet as JSON.
      match /exams/{id} {
        allow read, write: if isOwner(uid);
      }
      // Small key/value state, currently the exam in progress ("active_exam").
      match /app_state/{key} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
